# Copy to .env and fill in. NEVER commit .env.

# ---- Required ----
GROQ_API_KEY=
# Check console.groq.com/docs/models if this ever returns a 404.
GROQ_MODEL=qwen/qwen3.8-27b
# Asks for a password (any username). Always set this when the app is online.
APP_PASSWORD=change-me

# ---- Persistence ----
# The Docker image already sets these two. Change them only for a local run without Docker:
#   DATABASE_URL=sqlite:///./letterforge.db   and   STORAGE_DIR=./storage
DATABASE_URL=sqlite:////data/letterforge.db
STORAGE_DIR=/data/storage

# ---- Optional ----
# Comma-separated. Same-origin production needs nothing else. Never use *.
CORS_ORIGINS=http://localhost:5173
MAX_UPLOAD_MB=10

# ---- docker compose only ----
# Host folder mounted at /data on the VM (leave unset locally to use a Docker named volume).
DATA_DIR=/opt/letterforge-data
# 127.0.0.1 = reachable only through Caddy. Use 0.0.0.0 only to test from a phone on your LAN.
BIND_ADDR=127.0.0.1
